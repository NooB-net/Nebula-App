<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/iv_event_thumb"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:contentDescription="Event"
        android:scaleType="centerCrop"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_event_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"/>

        <TextView
            android:id="@+id/tv_event_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/nebula_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tv_event_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/nebula_text_secondary"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/tv_event_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@color/nebula_text_highlight"
            android:textSize="11sp"/>
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_item_reminder"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_pill"
        android:contentDescription="Set reminder"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_notification"
        android:tint="@color/nebula_icon"/>
</LinearLayout>
