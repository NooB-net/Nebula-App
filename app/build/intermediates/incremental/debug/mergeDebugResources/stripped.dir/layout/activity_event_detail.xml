<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nebula_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="260dp">

            <ImageView
                android:id="@+id/iv_event_hero"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Event"
                android:scaleType="centerCrop"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_scrim"/>

            <ImageButton
                android:id="@+id/ib_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="14dp"
                android:background="@drawable/bg_pill_media"
                android:contentDescription="Back"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/nebula_on_media"
                xmlns:app="http://schemas.android.com/apk/res-auto"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView android:id="@+id/tv_event_type" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.08"/>
            <TextView android:id="@+id/tv_event_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textColor="@color/nebula_text_primary" android:textSize="26sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tv_event_date" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textColor="@color/nebula_text_secondary" android:textSize="14sp"/>
            <TextView android:id="@+id/tv_event_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:background="@drawable/bg_pill" android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" android:textColor="@color/nebula_text_highlight" android:textSize="12sp"/>
            <TextView android:id="@+id/tv_event_desc" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:lineSpacingMultiplier="1.15" android:textColor="@color/nebula_text_body" android:textSize="15sp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="22dp" android:layout_marginBottom="8dp" android:text="Sky at event time"
                android:textColor="@color/nebula_text_primary" android:textSize="16sp" android:textStyle="bold"/>

            <com.nebula.app.ui.views.SkyChartView
                android:id="@+id/sky_chart_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:padding="6dp"/>

            <Button
                android:id="@+id/btn_set_reminder"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_button_primary"
                android:text="@string/set_reminder"
                android:textAllCaps="false"
                android:textColor="@color/nebula_on_primary"
                android:textSize="15sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
