<?xml version="1.0" encoding="utf-8"?>
<!--
  Nebula colour tokens: LIGHT theme (default).
  The DARK theme lives in values-night/colors.xml and MUST define exactly the same names.
  Never hardcode a hex colour in a layout / drawable / Java file: add or reuse a token here.
  Colours that must look identical in both themes (text on photos, camera overlays, scrims)
  live in colors_media.xml instead.
-->
<resources>
    <!-- Surfaces -->
    <color name="nebula_bg">#F3F4FB</color>
    <color name="nebula_surface">#FFFFFF</color>
    <color name="nebula_card">#FFFFFF</color>
    <color name="nebula_divider">#D5DAEE</color>
    <color name="nebula_media_placeholder">#E3E6F5</color>
    <color name="status_bar_color">#F3F4FB</color>

    <!-- Brand -->
    <color name="nebula_primary">#7B2FBE</color>
    <color name="nebula_primary_dark">#5A1F9A</color>
    <color name="nebula_secondary">#2563C9</color>
    <color name="nebula_accent">#7E22CE</color>
    <color name="nebula_accent_soft">#6D28D9</color>
    <color name="nebula_on_primary">#FFFFFF</color>
    <color name="nebula_button_start">#6D28D9</color>
    <color name="nebula_button_end">#9333EA</color>

    <!-- Text -->
